# ===== Vercel 支付后端环境变量（复制为 .env 用于 vercel dev 本地调试）=====
# Supabase（与网站前端同项目）
SUPABASE_URL=https://你的项目.supabase.co
# Project Settings → API → service_role key（secret，仅后端使用，勿公开）
SUPABASE_SERVICE_ROLE_KEY=

# 易支付商户配置（找任意"易支付"聚合支付开通，如彩虹易支付/自建网关）
EPAY_PID=商户ID
EPAY_KEY=商户密钥
# 网关提交地址，形如 https://pay.example.com/submit.php
EPAY_GATEWAY=https://pay.example.com/submit.php

# 网站真实域名（易支付付款成功后跳回此地址），形如 https://你的用户名.github.io
SITE_ORIGIN=

# ===== 店主 AI 深度解析（OpenAI 兼容，可选但推荐）=====
# 用户无需自带 Key；每次使用扣 1 次账号额度（服务端记账）
AI_ENDPOINT=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_KEY=

# 测试模式：=1 时建单返回"立即支付成功"的测试链接，可先不接易支付验证全流程
# 上线前务必改为 0 或删除
PAYMENT_TEST_MODE=0
